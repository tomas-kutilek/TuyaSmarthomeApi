import { NextResponse } from "next/server";

export async function POST(req: Request) {
  try {
    const { command } = await req.json();

    if (!command) {
      return NextResponse.json(
        { error: "Chýba príkaz v požiadavke." },
        { status: 400 }
      );
    }

    console.log("Prijatý hlasový príkaz:", command);

    // Sem môžete neskôr pridať volanie Tuya API alebo Google Home Webhooku
    // na základe rozpoznaného textu z 'command'

    return NextResponse.json({
      success: true,
      message: `Príkaz "${command}" bol úspešne prijatý.`,
    });
  } catch (error) {
    console.error("Chyba pri spracovaní príkazu:", error);
    return NextResponse.json(
      { error: "Interná chyba servera." },
      { status: 500 }
    );
  }
}
